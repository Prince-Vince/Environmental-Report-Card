        }

        /* ========== TITLE & HEADINGS ========== */
        .main-title {
            font-size: 48px;
            font-weight: bold;
            text-align: center;
            color: #333;
            margin-bottom: 25px;
        }

        /* ========== COLLAPSIBLE SECTIONS ========== */
        .section-title {
