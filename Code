            font-weight: bold;
            margin-top: 25px;
            margin-bottom: 5px;
            padding: 12px;
            border-radius: 5px;
            color: #ffffff;
            cursor: pointer; /* indicates clickable area */
            transition: background 0.3s; /* subtle hover effect */
            position: relative; /* for arrow positioning */
        }
        /* Arrow indicator (▼) at the right end of each section title */
        .section-title::after {
            content: "▼";
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            transition: transform 0.3s;
        }
        /* Rotate arrow when collapsed */
        .section-title.collapsed::after {
            transform: translateY(-50%) rotate(-90deg);
        }

