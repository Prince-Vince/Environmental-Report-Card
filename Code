<script>
function printForm() {
    // Expand all sections before printing
    document.querySelectorAll('.section-content.hidden').forEach(section => {
        section.classList.remove('hidden');
    });

    // Hide buttons and unnecessary elements before printing
    const elementsToHide = document.querySelectorAll('button, .submit-btn, .main-title, .section-title, input[type="text"], input[type="email"]');
    elementsToHide.forEach(el => el.style.display = 'none');

    // Process all inputs
    document.querySelectorAll("input").forEach(input => {
        let label = input.closest(".question, .sub-question")?.querySelector("label");

        if (!label) return; // Skip if there's no label

        // Handle radio buttons and checkboxes
        if ((input.type === "radio" || input.type === "checkbox") && input.checked) {
            // Display selected answer next to the question
            let answerText = document.createElement("span");
            answerText.innerHTML = ` <strong style="color:green;">(✔ Selected)</strong>`;
            label.appendChild(answerText);

            // If "No" was selected, highlight the question in red
            if (label.textContent.trim().toLowerCase().endsWith("no")) {
                label.style.color = "red";
                label.style.fontWeight = "bold";
            }
        }

        // Hide all unselected options
        if ((input.type === "radio" || input.type === "checkbox") && !input.checked) {
            input.parentElement.style.display = "none";
        }
    });

    // Restore elements after printing
    elementsToHide.forEach(el => el.style.display = '');
    document.querySelectorAll("input").forEach(input => input.style.display = "");

    // Remove dynamically added text after printing
    document.querySelectorAll("strong[style]").forEach(span => span.remove());
}
</script>

