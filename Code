    <script>
      /* ========== 1) Define your cappedGroups object  ========== */
      const cappedGroups = {
        // Example group: "funding"
        funding: {
          names: [
            "funding_recycling",
            "funding_energy_audits",
            "funding_natural_maintenance",
            "funding_natural_restoration",
            "funding_native_landscaping",
            "funding_stormwater",
            "funding_purchasing",
            "funding_alternative_fuel",
            "funding_energy_conservation",
            "funding_other"
          ],
          cap: 5
        },
        // ... (Insert all your other group definitions)
        // e.g. "capital", "purchasing", "disposal", etc.
      };

      /* ========== 2) generatePDF(): create PDF from form data ========== */
      function generatePDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        let yOffset = 10;
        doc.setFontSize(16);
        doc.text("IPRA Environmental Report Card", 10, yOffset);
        yOffset += 10;

        const form = document.getElementById("reportForm");
        const formData = new FormData(form);

        let content = "";
        for (let [key, value] of formData.entries()) {
          content += `${key}: ${value}\n`;
        }

        const splitContent = doc.splitTextToSize(content, 180);
        doc.setFontSize(12);
        doc.text(splitContent, 10, yOffset);

        doc.save("IPRA_Environmental_Report_Card.pdf");
      }

      /* ========== 3) updateTotal(): compute final score ========== */
      function updateTotal() {
        const form = document.getElementById("reportForm");
        const formData = new FormData(form);

        let uncappedTotal = 0;
        // Initialize sums for each group
        const groupSums = {};
        for (const groupKey in cappedGroups) {
          groupSums[groupKey] = 0;
        }

        // Loop over all selected form inputs
        for (let [name, value] of formData.entries()) {
          const numericVal = parseInt(value) || 0;

          // Check if this "name" belongs to one of our capped groups
          let foundGroup = null;
          for (const groupKey in cappedGroups) {
            const groupInfo = cappedGroups[groupKey];
            if (groupInfo.names.includes(name)) {
              foundGroup = groupKey;
              break;
            }
          }

          // If found in a group, add to that group's sum
          if (foundGroup) {
            groupSums[foundGroup] += numericVal;
          } else {
            // Not in a capped group => add to uncappedTotal
            uncappedTotal += numericVal;
          }
        }

        // Apply the caps for each group
        let cappedTotal = 0;
        for (const groupKey in cappedGroups) {
          const groupInfo = cappedGroups[groupKey];
          const rawSum = groupSums[groupKey];
          const cap = groupInfo.cap;
          cappedTotal += Math.min(rawSum, cap);
        }

        // Final total = uncappedTotal + sum of each group's capped result
        const finalTotal = uncappedTotal + cappedTotal;

        // Display
        document.getElementById("totalPoints").innerText = finalTotal;
      }

      /* ========== 4) toggleSection(): collapsible sections ========== */
      function toggleSection(titleElemId, sectionId) {
        const titleElem = document.getElementById(titleElemId);
        const section = document.getElementById(sectionId);
        if (!section || !titleElem) return;

        section.classList.toggle("hidden");
        titleElem.classList.toggle("collapsed"); // rotates arrow
      }

      /* ========== 5) toggleSubQuestions(): show/hide sub-questions ========== */
      function toggleSubQuestions(value, subQuestionId) {
        const subQuestions = document.getElementById(subQuestionId);
        if (!subQuestions) return;

        if (value === "1") {
          subQuestions.classList.remove("hidden");
        } else {
          subQuestions.classList.add("hidden");
        }
        // after toggling, recalc total
        updateTotal();
      }
 

    </script>
