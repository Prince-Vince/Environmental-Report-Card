    <style>
        /* ========== BASIC PAGE & CONTAINER STYLES ========== */
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Roboto', sans-serif; 
            background-color: #f4f4f4;
            margin: 20px;
            padding: 20px;
            line-height: 1.6; /* improves readability */
        }
        .container {
            max-width: 1100px;
