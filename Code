        .section-title:hover {
            filter: brightness(0.95);
        }

        .section-content {
            margin-top: 10px;
            margin-bottom: 20px;
            overflow: hidden; /* simple show/hide approach */
        }
        .hidden {
            display: none;
        }

        /* ========== QUESTION & SUB-QUESTION STYLES ========== */
        /* Container that holds the three fields side by side */
        .inline-fields {
            display: flex;          /* enable Flexbox for horizontal layout */
            gap: 1rem;              /* spacing between columns */
            flex-wrap: wrap;        /* wrap to next line if too narrow */
            align-items: flex-end;  /* align bottoms of fields, or 'center' if you prefer */
            margin-bottom: 1.5rem;  /* spacing below the row */
        }

        /* Each .field is one column: label + input stacked vertically */
        .inline-fields .field {
            flex: 1;                /* each field grows/shrinks equally */
            min-width: 200px;       /* ensures they don’t get too squished */
            display: flex;
            flex-direction: column; /* label above input */
        }

        /* Modern label styling */
        .inline-fields .field label {
            font-weight: bold;
            margin-bottom: 0.3rem;
            color: #333;            /* dark gray text */
        }

